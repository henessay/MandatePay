# MandatePay environment — copy to .env and fill in. NEVER commit .env.
# Every value here is intentionally empty. The app runs fully offline with the
# defaults below; live values are only needed to flip onto a real T3N node.

# ---- Disbursement rail selector --------------------------------------------
# "mock" (default, fully offline) | "t3-payroll" (live tee:payroll node)
MANDATEPAY_RAIL=mock

# ---- Terminal 3 / T3N node -------------------------------------------------
# Testnet node base URL (e.g. https://<node>.terminal3.io). Leave empty for offline.
T3N_NODE_URL=
# Demo EOA private key for the agent / CFO signing in dev (0x-prefixed, 32 bytes).
# In production the TEE holds keys (custodial); this is for local offline signing only.
T3N_DEMO_KEY=
# Optional API key / bearer if the node edge gates /api/rpc.
T3N_API_KEY=

# ---- On-chain mirror (MandatePolicy.sol) -----------------------------------
# Filled in after the owner deploys MandatePolicy to a testnet.
MANDATE_POLICY_ADDRESS=
CHAIN_RPC_URL=

# ---- LLM (agent judgment layer) --------------------------------------------
# Anthropic API key. Leave empty to run the agent on the deterministic mock LLM.
ANTHROPIC_API_KEY=
# Model id for the judgment layer (defaults applied in code if empty).
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Web app ---------------------------------------------------------------
# Exposed to the browser: which rail the UI should claim to be using.
NEXT_PUBLIC_MANDATEPAY_RAIL=mock
